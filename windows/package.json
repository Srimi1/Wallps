{
  "name": "wallps",
  "productName": "Wallps",
  "version": "1.0.0",
  "description": "Ultra-Minimal 4K Live Video Wallpapers for Windows & macOS",
  "main": "src/main/main.js",
  "author": "Wallps Contributors",
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build:win": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:nsis": "electron-builder --win nsis"
  },
  "dependencies": {
    "koffi": "^3.1.6"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.wallps.Wallps",
    "productName": "Wallps",
    "copyright": "Copyright © 2026 Wallps contributors. Apache-2.0",
    "directories": {
      "output": "../build/windows"
    },
    "files": [
      "package.json",
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!src/**/*.test.js"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/@koromix/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "publisherName": "Wallps Contributors"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Wallps"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    }
  }
}
